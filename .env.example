# Required configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id

# Recommended for stable operation
POLYGON_RPC_URL=https://polygon-rpc.com
# Etherscan V2 API key works for both Ethereum and Polygon
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: outbound proxy for HTTP(S)/RPC/WebSocket traffic
# Format: https://login:password@ip:port
PROXY=
# Optional: outbound HTTP timeout for axios/clob-client requests (ms)
# OUTBOUND_HTTP_TIMEOUT_MS=20000

# 5M "Split & Sell the Loser" Strategy Parameters
SPLIT_SELL_ENABLED=true
PAPER_MODE=true
SPLIT_SIZE_USD=10
ENTRY_WINDOW_MIN_SEC=60
ENTRY_WINDOW_MAX_SEC=120
MIN_FAVOURITE_PRICE=0.75
REQUIRE_BINANCE_CONFIRM=true
SELL_MODE=limit
SELL_TIMEOUT_SEC=20
MAX_SPREAD=0.03
MAX_ROUNDS_PER_DAY=30
DAILY_LOSS_LIMIT_USD=50
MAX_CONSECUTIVE_LOSSES=3

# Optional/advanced parameters are documented in README.md
